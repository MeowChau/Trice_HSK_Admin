# Private staging through SSH: open http://localhost:8080 on your PC.
NODE_ENV=production
APP_NAME="TriceHSK API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:8080
BACKEND_DOMAIN=http://localhost:8080
APP_CORS_ORIGINS=http://localhost:8080,http://localhost:3000

DATABASE_TYPE=postgres
DATABASE_NAME=tricehsk
DATABASE_USERNAME=tricehsk
DATABASE_PASSWORD=GENERATE_ME
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false

FILE_DRIVER=local
FILE_MAX_SIZE=104857600

# Test messages appear in Maildev, not the recipient's actual inbox.
MAIL_HOST=maildev
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=TriceHSK

AUTH_JWT_SECRET=GENERATE_ME
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=GENERATE_ME
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_SECRET=GENERATE_ME
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=GENERATE_ME
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
AUTH_UNIFORM_ERRORS=true
AUTH_RATE_LIMIT=10

# Replace this email before the first seed. init-env.sh generates the password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=GENERATE_ME
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_APP_AUDIENCE=[]
